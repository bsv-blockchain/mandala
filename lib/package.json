{
  "name": "@bsv/mandala",
  "version": "0.1.0",
  "description": "Token client for Mandala overlay assets — send, receive, and administer any asset with overlay-first commit and journaled recovery.",
  "license": "Open BSV",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "default": "./dist/index.js" },
    "./package.json": "./package.json",
    "./*": { "types": "./dist/*.d.ts", "import": "./dist/*.js", "default": "./dist/*.js" }
  },
  "files": ["dist"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bsv/message-box-client": "^2.2.0",
    "@bsv/sdk": "^2.1.6",
    "@bsv/templates": "^1.9.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.9"
  }
}
