# Fresh node name for the BRC-162 token-topics overlay. The Mongo database is
# <NODE_NAME>_lookup_services. NEVER reuse "mandala" (the old-format overlay's
# state) or "mandala162" (the TS P2 overlay's state): this overlay is a clean
# break and must not read or write either database.
NODE_NAME=mandala_q3
SERVER_PRIVATE_KEY=replace_with_output_of_openssl_rand_hex_32
HOSTING_URL=http://localhost:8081
# Any path in MONGO_URL (/mandala below) is ignored: the database name always
# comes from NODE_NAME.
MONGO_URL=mongodb://mongodb:27017/mandala
NETWORK=test
# REQUIRED: the trusted issuers, a JSON array of compressed identity public
# keys (02/03 + 64 lowercase hex). Only a deploy signed by one of these keys
# registers a token, and only they may hold authority outputs. Keep the single
# quotes: a shell sourcing this file would otherwise strip the JSON's double
# quotes.
MANDALA_ISSUER_KEYS='["replace_with_the_issuer_identity_public_key"]'
# Optional: host only these tokens, a JSON array of deploy txids (64 lowercase
# hex, no _0 suffix). Unset or blank follows every token the registry admits;
# '[]' hosts no token at all. A submit naming any other tm_<txid> answers 400
# ERR_SHAPE unknown-topic. Changes take effect on restart.
#MANDALA_TOKEN_ALLOWLIST='[]'
# Optional: the listen port (default 8080). Locally the TS P2 overlay already
# listens on 8080, so run this one on 8081 beside it.
#PORT=8081
# Optional: point at an Arcade v2 node to make the overlay broadcast accepted
# txs (POST $ARCADE_URL/tx), refresh merkle proofs, and run full SPV (headers +
# merkle-root verification + reorg SSE) via the chaintracks client instead of
# the local scripts-only mode. Leave unset for the local demo.
#ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
#ARCADE_API_KEY=
# Shared secret Arcade must present (Authorization: Bearer <token> or
# x-callback-token: <token>) on its POST /arc-ingest callbacks. REQUIRED
# whenever ARCADE_URL is set: a terminal-status callback evicts the
# transaction, which restores its inputs and permanently voids its admission
# signatures, so an unauthenticated /arc-ingest is an unwind primitive for
# anyone who can reach the node. Left unset, /arc-ingest is NOT mounted at all
# (the server logs an error and keeps serving every other route).
#ARCADE_CALLBACK_TOKEN=
# Chaintracks defaults to $ARCADE_URL/chaintracks with API prefix /v2; override
# either independently if the chain tracker lives elsewhere.
#CHAINTRACKS_URL=https://arcade-v2-us-1.bsvblockchain.tech/chaintracks
#CHAINTRACKS_API_PREFIX=/v2
# A13: bearer token gating the identity-bearing admin routes (GET
# /admin/registry, /admin/activity, /admin/admission/:txid). The token routes
# (/admin/tokens, /admin/authorities*, /admin/asset-state, /admin/admin-history*,
# /admin/admin-summary) and /admin/registry/beef stay public so recovery works
# without a console token. Left unset, the gated routes stay open too, and the
# server logs one startup warning saying so. Set this before any public demo.
#ADMIN_API_TOKEN=
# Comma-separated list of console origins allowed to read the gated routes
# above (CORS). Left unset, defaults to HOSTING_URL's origin plus
# http://127.0.0.1:5173 and http://localhost:5173.
#ADMIN_CORS_ORIGINS=
