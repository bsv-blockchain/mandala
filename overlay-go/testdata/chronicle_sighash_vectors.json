{
  "note": "Shared TS/Go vectors for the version-gated SIGHASH_CHRONICLE rule. Every BEEF is an AtomicBEEF of one-input P2PKH spends (fixed key, RFC6979, deterministic) whose source tx is proven by a trivial merkle path. plain = SIGHASH_ALL|FORKID (0x41); chronicle = SIGHASH_ALL|FORKID|CHRONICLE (0x61). tsVerifies is the measured result of @bsv/sdk 2.8.11 Transaction.fromBEEF(bytes).verify(tracker) and of the TS overlay Engine.submit on these exact bytes (true = admitted, false = script error thrown, answered 503 ERR_UNAVAILABLE). The Go overlay (wiring.CheckChronicleSighashRule, then go-sdk spv.Verify) must give the same verdict, except where knownGap is set. Both stacks read this one file: overlay/src/chronicleSighashParity.test.ts and overlay-go/internal/wiring/script_rules_test.go (which also rebuilds every vector and fails if the bytes drift).",
  "vectors": [
    {
      "name": "v1_plain",
      "tsVerifies": true,
      "description": "v1 tx, plain signature",
      "beefHex": ""
    },
    {
      "name": "v1_chronicle",
      "tsVerifies": false,
      "description": "v1 tx, SIGHASH_CHRONICLE signature: TS refuses (not after-Chronicle at version 1)",
      "beefHex": ""
    },
    {
      "name": "v2_plain",
      "tsVerifies": true,
      "description": "v2 tx, plain signature",
      "beefHex": ""
    },
    {
      "name": "v2_chronicle",
      "tsVerifies": true,
      "description": "v2 tx, SIGHASH_CHRONICLE signature: after-Chronicle, accepted",
      "beefHex": ""
    },
    {
      "name": "v2_child_of_unproven_v1_chronicle",
      "tsVerifies": false,
      "description": "v2 child of an UNPROVEN v1 parent whose input carries a SIGHASH_CHRONICLE signature: the ancestor is script-verified, so refused",
      "beefHex": ""
    },
    {
      "name": "v2_child_of_proven_v1_chronicle",
      "tsVerifies": true,
      "description": "same, but the v1 parent carries a merkle path: a proven tx ends the walk, so its inputs are never verified",
      "beefHex": ""
    },
    {
      "name": "v2_child_of_proven_v1_chronicle_ancestor_present",
      "tsVerifies": true,
      "description": "same chain as a plain BEEF V2 that ALSO carries the proven parent's own ancestor: the parsed graph links the parent's input to a source, but a proven tx still ends the walk (this is the vector that exercises the skip)",
      "beefHex": ""
    },
    {
      "name": "v1_chronicle_after_chronicle_opcode",
      "tsVerifies": false,
      "description": "v1 tx whose lock runs OP_2MUL before the CHECKSIG, signed with SIGHASH_CHRONICLE: TS accepts the opcode and refuses the signature",
      "knownGap": "the pre-check runs the interpreter pre-Chronicle, which stops at the Chronicle-only OP_2MUL before reaching the CHECKSIG; the engine then admits (open corner, see CheckChronicleSighashRule)",
      "beefHex": ""
    }
  ]
}
