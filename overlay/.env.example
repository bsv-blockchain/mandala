NODE_NAME=mandala
SERVER_PRIVATE_KEY=replace_with_output_of_npm_run_gen-key
# Public URL of this overlay. http://localhost:8080 is fine for the local demo;
# with ARCADE_URL set it must be the public https:// URL (see ARCADE_CALLBACK_TOKEN).
HOSTING_URL=http://localhost:8080
MONGO_URL=mongodb://mongodb:27017/mandala
NETWORK=test
SQLITE_FILE=/data/overlay.sqlite
# Optional: point at an Arcade v2 node to make the overlay broadcast accepted
# txs (POST $ARCADE_URL/tx), refresh merkle proofs, and run full SPV (headers +
# merkle-root verification + reorg SSE) via go-chaintracks instead of the local
# scripts-only mode. Leave unset for the local demo.
#ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
#ARCADE_API_KEY=
# REQUIRED whenever ARCADE_URL is set: the overlay refuses to boot without it.
# The shared secret Arcade must present on POST /arc-ingest, as
# "Authorization: Bearer <token>" or "X-Callback-Token: <token>". A terminal
# status on that route EVICTS an admitted transaction and restores the inputs
# it spent (FIX E), so an unauthenticated route lets anyone on the network
# strand or resurrect a coin. Must be 32 to 16384 UTF-8 bytes with no
# leading/trailing whitespace (a trailing newline from a secret store fails the
# boot) and no control characters.
# With ARCADE_URL set, HOSTING_URL must also be the overlay's PUBLIC https://
# URL: Arcade calls back https://<host>/arc-ingest, so an http or scheme-less
# HOSTING_URL fails the boot.
#ARCADE_CALLBACK_TOKEN=
# Chaintracks defaults to $ARCADE_URL/chaintracks with API prefix /v2; override
# either independently if the chain tracker lives elsewhere.
#CHAINTRACKS_URL=https://arcade-v2-us-1.bsvblockchain.tech/chaintracks
#CHAINTRACKS_API_PREFIX=/v2
# overlay-express refuses plain-http and private-network (docker hostname, RFC
# 1918, loopback) Arcade/Chaintracks URLs unless this is true. It applies to
# both services. Only for an isolated local http/private-network Arcade — never
# set it in production.
#ARCADE_ALLOW_PRIVATE_HOSTS=false
# A13: bearer token gating the identity-bearing admin routes (GET
# /admin/registry, /admin/activity, /admin/admission/:txid — NOT the public
# audit routes: asset-state*, admin-history*, admin-summary*, asset-auth*,
# registry/beef/*, which stay open so recovery works without a console
# token). Left unset, those routes stay open too, and the server logs one
# startup warning saying so — set it before any public demo. When set it must
# be 32 to 16384 UTF-8 bytes with no leading/trailing whitespace and no control
# characters, or the boot fails.
#ADMIN_API_TOKEN=
# Comma-separated list of console origins allowed to read the gated routes
# above (CORS). Left unset, defaults to HOSTING_URL's origin plus
# http://127.0.0.1:5173 and http://localhost:5173 (the console's local dev
# origins).
#ADMIN_CORS_ORIGINS=
