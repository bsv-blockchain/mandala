NODE_NAME=mandala
SERVER_PRIVATE_KEY=replace_with_output_of_npm_run_gen-key
HOSTING_URL=http://localhost:8080
MONGO_URL=mongodb://mongodb:27017/mandala
NETWORK=test
SQLITE_FILE=/data/overlay.sqlite
# Optional: point at an Arcade v2 node to make the overlay broadcast accepted
# txs (POST $ARCADE_URL/tx), refresh merkle proofs, and run full SPV (headers +
# merkle-root verification + reorg SSE) via go-chaintracks instead of the local
# scripts-only mode. Leave unset for the local demo.
#ARCADE_URL=https://arcade-v2-us-1.bsvblockchain.tech
#ARCADE_API_KEY=
# REQUIRED whenever ARCADE_URL is set. The shared secret Arcade must present on
# POST /arc-ingest, as "Authorization: Bearer <token>" or "x-callback-token:
# <token>". A terminal status on that route EVICTS an admitted transaction and
# restores the inputs it spent (FIX E), so an unauthenticated route lets anyone
# on the network strand or resurrect a coin. Left empty, /arc-ingest is NOT
# mounted: a blocking 503 stub takes the path (so the upstream
# @bsv/overlay-express route, which only checks this token when it is non-empty,
# can never be reached), one error is logged at boot, and the server keeps
# serving everything else — merkle proofs included, since those also arrive on
# this route.
#ARCADE_CALLBACK_TOKEN=
# Chaintracks defaults to $ARCADE_URL/chaintracks with API prefix /v2; override
# either independently if the chain tracker lives elsewhere.
#CHAINTRACKS_URL=https://arcade-v2-us-1.bsvblockchain.tech/chaintracks
#CHAINTRACKS_API_PREFIX=/v2
# A13: bearer token gating the identity-bearing admin routes (GET
# /admin/registry, /admin/activity, /admin/admission/:txid — NOT the public
# audit routes: asset-state*, admin-history*, admin-summary*, asset-auth*,
# registry/beef/*, which stay open so recovery works without a console
# token). Left unset, those routes stay open too, and the server logs one
# startup warning saying so. Set this before any public demo.
#ADMIN_API_TOKEN=
# Comma-separated list of console origins allowed to read the gated routes
# above (CORS). Left unset, defaults to HOSTING_URL's origin plus
# http://127.0.0.1:5173 and http://localhost:5173 (the console's local dev
# origins).
#ADMIN_CORS_ORIGINS=
