VITE_OVERLAY_URL=http://localhost:8082
# REQUIRED. The app refuses to start without the overlay's identity key (fail closed).
# 66 lowercase hex chars (compressed, 02/03 prefix), from the overlay-go boot log.
VITE_OVERLAY_IDENTITY_KEY=paste_identity_key_from_overlay-go_boot_log
VITE_MESSAGEBOX_URL=https://messagebox.bsvblockchain.tech
# Optional: bearer token for the overlay's identity-bearing /admin routes (registry, activity).
# Leave empty until the overlay enforces it.
VITE_ADMIN_API_TOKEN=
